{
  "manifest_version": 3,
  "name": "Etiquetas 2/3 A4",
  "version": "1.0.0",
  "description": "Reorganiza etiquetas de envío en hojas A4 de dos tercios para aprovechar papel reutilizado.",
  "permissions": ["storage", "tabs", "downloads", "offscreen"],
  "host_permissions": ["file:///*"],
  "action": {
    "default_title": "Preparar etiquetas para hoja 2/3 A4",
    "default_popup": "app.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
